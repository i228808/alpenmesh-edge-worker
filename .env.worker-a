# ==========================================================================
# alpenmesh-edge-worker — multi-worker template: WORKER A
#
# Load with:   set WORKER_ENV=.env.worker-a && cargo run --release
#              (PowerShell: $env:WORKER_ENV=".env.worker-a"; cargo run --release)
# ==========================================================================

WORKER_IDENTITY_PATH=%APPDATA%\alpenmesh\worker_a_identity.json

WORKER_EXTERNAL_ADDR=127.0.0.1:8081
WORKER_CONFIG=app.yaml

SCHEDULER_URL=http://127.0.0.1:3000
ECONOMY_URL=http://127.0.0.1:3010

ACCIDENT_DEBUG=1

RUST_LOG=info,alpenmesh_worker=debug
