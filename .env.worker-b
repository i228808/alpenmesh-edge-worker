# ==========================================================================
# alpenmesh-edge-worker — multi-worker template: WORKER B
#
# Load with:   set WORKER_ENV=.env.worker-b && cargo run --release
#              (PowerShell: $env:WORKER_ENV=".env.worker-b"; cargo run --release)
# ==========================================================================

WORKER_IDENTITY_PATH=%APPDATA%\alpenmesh\worker_b_identity.json

WORKER_EXTERNAL_ADDR=127.0.0.1:8082
WORKER_CONFIG=app.worker2.yaml

SCHEDULER_URL=http://127.0.0.1:3000
ECONOMY_URL=http://127.0.0.1:3010

ACCIDENT_DEBUG=1

RUST_LOG=info,alpenmesh_worker=debug
